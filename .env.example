# Placeholder configuration for synthetic mode or the local private runtime.
# Keep populated configuration outside the source tree. Never commit it.
# Synthetic mode consumes only APP_MODE and PORT. private-local requires the settings below.
APP_MODE=synthetic
PORT=4173
# Server-only settings; private-local rejects missing/placeholder required values.
APP_ORIGIN=REPLACE_WITH_EXACT_LOCAL_ORIGIN
SUPABASE_URL=REPLACE_WITH_LOCAL_AUTH_URL
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY
APP_DATABASE_URL=REPLACE_WITH_RESTRICTED_APPLICATION_ROLE_CONNECTION
AUTH_DATABASE_URL=REPLACE_WITH_RESTRICTED_AUTH_BROKER_ROLE_CONNECTION
SESSION_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
SESSION_ENCRYPTION_KEY_ID=REPLACE_WITH_LOCAL_KEY_VERSION_LABEL
# Optional JSON map of previous key IDs to base64 keys for rotation overlap.
# SESSION_PREVIOUS_KEYS={"REPLACE_WITH_PREVIOUS_KEY_ID":"REPLACE_WITH_PREVIOUS_BASE64_KEY"}
SESSION_TTL_SECONDS=REPLACE_WITH_REVIEWED_SESSION_TTL_SECONDS
SESSION_VALIDITY_TIMEOUT_MS=REPLACE_WITH_FINITE_LOOKUP_TIMEOUT_MS
PRIVATE_REQUEST_TIMEOUT_MS=REPLACE_WITH_FINITE_REQUEST_TIMEOUT_MS
DATABASE_STATEMENT_TIMEOUT_MS=REPLACE_WITH_FINITE_STATEMENT_TIMEOUT_MS
# Synthetic enrollment only; populate the server-side allowed-owner table during setup.
SYNTHETIC_OWNER_ID=REPLACE_WITH_DISPOSABLE_SYNTHETIC_USER_UUID
# Optional development override: resolved before the shim enters PATH.
# DOCKER_BIN=REPLACE_WITH_ABSOLUTE_DOCKER_EXECUTABLE_PATH
# No service-role/admin key belongs in the normal application runtime.
# Schema/enrollment setup and key recovery require separate reviewed procedures.
